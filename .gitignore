build/
build-*/
compile_commands.json
# Recorded captures are large and belong to whoever recorded them.
#
# Note the trailing /* rather than a bare data/. Git will not descend into an
# excluded DIRECTORY, so a bare `data/` makes the re-include below unreachable
# and `git add data/samples` fails with nothing but a hint. Excluding the
# directory's CONTENTS leaves the directory itself visible, so the exception
# works. This cost a round trip; it is written down so it does not cost another.
data/*
# ..except the committed captures the real-data regression tests replay. A test
# against synthetic data only ever proves the decoder agrees with the generator
# that wrote it.
!data/samples/
*.hgrm
*.journal
.cache/

# Generated by tools/figures.py from the committed captures. Kept in the repo
# because a claim in the docs should be one click from the picture of it.
!docs/figures/

# Working directories for the calibration pipeline. Regenerated by
# apps/stats + tools/mdp_params.py from the committed captures and the
# simulator; what belongs in the repo is the answer in policy/, not the
# hundreds of megabytes of CSV that produced it.
csv/
simcsv/
simpolicy/

# Python bytecode, created whenever a tool is imported (the recorder's offline
# tests import it directly).
__pycache__/
*.pyc
